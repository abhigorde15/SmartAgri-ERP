# Server Configuration
PORT=5000
NODE_ENV=production

# Database (PostgreSQL - Neon, Supabase, Railway, Vercel Postgres, or AWS RDS)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Authentication Security (Generate a random 32+ character string)
JWT_SECRET="replace_with_a_secure_random_32_plus_char_secret_key"
JWT_EXPIRES_IN="1d"

# CORS / Allowed Frontend URLs (comma-separated for multiple origins)
CLIENT_URL="http://localhost:3000,https://your-app.vercel.app"

# Google Gemini AI Copilot (Get API key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
