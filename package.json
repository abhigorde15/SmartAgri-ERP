{
  "name": "smartagri-erp",
  "version": "1.0.0",
  "private": true,
  "description": "SmartAgri ERP - Fertilizer Manufacturing & Distribution ERP with Gemini AI Copilot",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build:frontend": "npm --workspace=frontend run build",
    "build:backend": "npm --workspace=backend run build",
    "build": "npm --workspace=frontend run build"
  }
}
