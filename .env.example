# =================================================================
# SmartAgri ERP - Master Environment Variables Template
# =================================================================

# Database Configuration (PostgreSQL required)
# Providers: Supabase (supabase.com), Neon (neon.tech), Railway, or Vercel Postgres
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# JWT Security
JWT_SECRET="replace_with_a_secure_random_32_plus_char_secret_key"
JWT_EXPIRES_IN="1d"

# Server Port (Default: 5000)
PORT=5000
NODE_ENV=production

# CORS / Allowed Client Origins
CLIENT_URL="http://localhost:3000,https://your-app.vercel.app"

# Google Gemini AI Copilot (Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key_here"

# Frontend API URL (leave blank if deploying API and Frontend on same Vercel project)
VITE_API_URL=

